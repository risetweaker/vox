{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOX",
  "version": "0.1.0",
  "identifier": "net.vox.tweaking.utility",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VOX",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#080b12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://vox-tweaking-utility.netlify.app; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Transparent cross-platform system tweaks",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
